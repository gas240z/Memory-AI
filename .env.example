# Memory Lab: пример настроек. Скопируйте в .env и впишите свой ключ. Сам .env в git не попадает.

# true = реальный режим (Claude + mem0)
USE_REAL_MEMORY=true

# Ключ Anthropic: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Модель для ответов, конспекта, сущностей и извлечения фактов в mem0
ANTHROPIC_MODEL=claude-haiku-5-5

# Эмбеддинги для mem0: huggingface (локально, бесплатно, понимает русский) или openai
MEM0_EMBEDDER=huggingface
MEM0_HF_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# Нужен только если MEM0_EMBEDDER=openai
OPENAI_API_KEY=

# Размер окна в обменах (1 обмен = 2 сообщения)
WINDOW_EXCHANGES=2
